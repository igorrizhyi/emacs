# Tester agent container for agent-shell-team
# Build: podman build -t agent-tester:latest -f Dockerfile.tester .
# Used by: agent-shell-team.el for containerized tester agents

FROM node:22-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        git \
        python3 \
        python3-pip \
        python3-venv \
        curl \
        jq && \
    rm -rf /var/lib/apt/lists/*

RUN npm install -g @anthropic-ai/claude-code

WORKDIR /workspace

CMD ["sleep", "infinity"]
